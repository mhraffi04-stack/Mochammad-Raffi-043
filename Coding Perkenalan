<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Perkenalan Diri ✨</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,600;1,400&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: linear-gradient(135deg, #1e2339 0%, #0f1221 100%);
            font-family: 'Poppins', sans-serif;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #fff;
            padding: 20px;
        }
        .profile-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 35px 30px;
            border-radius: 24px;
            text-align: center;
            max-width: 450px;
            width: 100%;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
            animation: fadeIn 1.2s ease-in-out;
        }
        .avatar-placeholder {
            width: 85px;
            height: 85px;
            background: linear-gradient(135deg, #ff758c 0%, #ff7eb3 100%);
            border-radius: 50%;
            margin: 0 auto 18px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 34px;
            box-shadow: 0 8px 20px rgba(255, 117, 140, 0.4);
        }
        h1 {
            font-family: 'Playfair Display', serif;
            font-size: 24px;
            margin-bottom: 4px;
            color: #fff;
        }
        .subtitle {
            font-size: 13px;
            color: #ffb6c1;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            font-weight: 600;
            margin-bottom: 20px;
        }
        
        /* List Informasi Diri */
        .info-container {
            text-align: left;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 14px;
            padding: 15px 20px;
            margin-bottom: 25px;
            border-left: 3px solid #ff758c;
        }
        .info-item {
            margin-bottom: 12px;
        }
        .info-item:last-child {
            margin-bottom: 0;
        }
        .info-label {
            font-size: 11px;
            color: #9ca3af;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            display: block;
            margin-bottom: 2px;
        }
        .info-value {
            font-size: 14px;
            color: #f3f4f6;
            font-weight: 500;
        }

        .btn-greet {
            background: linear-gradient(135deg, #ff758c 0%, #ff7eb3 100%);
            color: white;
            border: none;
            padding: 12px 28px;
            font-size: 14px;
            font-weight: 600;
            border-radius: 25px;
            cursor: pointer;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            box-shadow: 0 5px 15px rgba(255, 117, 140, 0.4);
        }
        .btn-greet:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(255, 117, 140, 0.6);
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

    <div class="profile-card">
        <div class="avatar-placeholder">👨‍💻</div>
        <h1>Perkenalan Diri</h1>
        <div class="subtitle">Personal Profile</div>
        
        <div class="info-container">
            <div class="info-item">
                <span class="info-label">Nama Lengkap</span>
                <span class="info-value">Mochammad Raffi</span>
            </div>
            <div class="info-item">
                <span class="info-label">Universitas</span>
                <span class="info-value">Universitas PGRI Ronggolawe</span>
            </div>
            <div class="info-item">
                <span class="info-label">Alamat Domisili</span>
                <span class="info-value">Kabupaten Tuban</span>
            </div>
        </div>

        <button class="btn-greet" onclick="sapaPengunjung()">Kirim Sapaan 🚀</button>
    </div>

    <script>
        function sapaPengunjung() {
            let nama = prompt("Masukkan nama kamu:");
            if (nama) {
                alert("Halo " + nama + "! Senang bisa berkenalan sama kamu! ✨");
            } else {
                alert("Semoga kita bisa bertemu lagi dilain waktu! 🌸");
            }
        }
    </script>

</body>
</html>
